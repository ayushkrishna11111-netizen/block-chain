# ---- Backend API ----
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL 8 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=academic_db

# ---- Blockchain ----
# Local hardhat node default; swap for an Alchemy/Infura Sepolia URL in production
RPC_URL=http://127.0.0.1:8545
# Server-side issuer signer (used for automatic record anchoring).
# For a local `npx hardhat node`, hardhat account #0 works:
# 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SIGNER_PRIVATE_KEY=
# Deployed AcademicRecordManager address (printed by scripts/deploy.js)
CONTRACT_ADDRESS=

# ---- IPFS / Pinata (optional: leave empty to store hashes only) ----
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ---- Identity ----
# Empty = open registration for demo. Set to require an invite code to register.
REGISTRATION_CODE=

# ---- Document encryption at rest (AES-256-GCM) ----
# 32-byte hex key (64 hex chars) used to encrypt stored PDFs.
DOCUMENT_ENC_KEY=
